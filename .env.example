## TWITCH CONFIGURATION
# Twitch application client ID.
TWITCH_CLIENT_ID=

# Raw user access token with user:read:chat and user:write:chat scopes.
TWITCH_ACCESS_TOKEN=

# User ID of the channel to read and write.
TWITCH_BROADCASTER_ID=

# Optional bot account user ID; defaults to TWITCH_BROADCASTER_ID.
TWITCH_BOT_USER_ID=


## LLAMA CONFIGURATION
# Concurrent llama.cpp server slots and live-test requests; defaults to 4.
BATCHSIZE=4

# Optional llama.cpp server URL; defaults to http://127.0.0.1:8080.
LLAMA_SERVER_URL=

# Optional llama.cpp model alias; defaults to qwen3.5-9b.
LLAMA_MODEL=

# Number of retries after a timeout or unexpected response format; defaults to 2.
LLAMA_RETRIES=3

# Per-attempt llama.cpp timeout in seconds; defaults to 30.
LLAMA_TIMEOUT_SECONDS=
