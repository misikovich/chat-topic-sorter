# Twitch application client ID.
TWITCH_CLIENT_ID=

# Raw user access token with user:read:chat and user:write:chat scopes.
TWITCH_ACCESS_TOKEN=

# User ID of the channel to read and write.
TWITCH_BROADCASTER_ID=

# Optional bot account user ID; defaults to TWITCH_BROADCASTER_ID.
TWITCH_BOT_USER_ID=
