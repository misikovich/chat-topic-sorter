## TWITCH CONFIGURATION
# Twitch application client ID.
TWITCH_CLIENT_ID=

# Raw user access token with user:read:chat and user:write:chat scopes.
TWITCH_ACCESS_TOKEN=

# Channel login name to connect to; resolved to an ID at startup.
TWITCH_CHANNEL=

# Numeric user ID of the channel; required only when TWITCH_CHANNEL is unset.
TWITCH_BROADCASTER_ID=

# Optional bot account user ID; defaults to TWITCH_BROADCASTER_ID.
TWITCH_BOT_USER_ID=


## EMBEDDING CONFIGURATION
# Hugging Face model, pinned revision, and output dimensions.
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSIONS=384

# Optional bearer token; loopback uv startup does not require one.
EMBEDDING_API_KEY=

# Local embedding server port and replica devices.
EMBEDDING_PORT=8091
EMBEDDING_DEVICES=auto

# Model startup and inference timeout in seconds.
EMBEDDING_INFERENCE_TIMEOUT_SECONDS=900


## TOPIC CONFIGURATION
# Minimum cosine similarity for a message to join an existing topic; defaults to 0.5.
TOPIC_AFFINITY_THRESHOLD=

# Weight (0..1, exclusive) of each joining message when nudging the topic centroid; defaults to 0.1.
# Lower values keep the topic theme anchored; higher values let it drift with the discussion.
TOPIC_CENTROID_ALPHA=

# Every 4th message a topic's average message-to-centroid similarity is checked; below this
# threshold (0..1, exclusive, defaults to 0.5) the topic is rebuilt from its recent messages and re-titled.
TOPIC_COHERENCE_THRESHOLD=


## LLAMA CONFIGURATION
# Concurrent llama.cpp server slots and live-test requests; defaults to 4.
BATCHSIZE=4

# Optional llama.cpp server URL; defaults to http://127.0.0.1:8080.
LLAMA_SERVER_URL=

# Optional llama.cpp model alias; defaults to qwen3.5-9b.
LLAMA_MODEL=

# Number of retries after a timeout or unexpected response format; defaults to 2.
LLAMA_RETRIES=3

# Per-attempt llama.cpp timeout in seconds; defaults to 30.
LLAMA_TIMEOUT_SECONDS=


## WEBSERVER CONFIGURATION
# Dashboard HTTP port; defaults to 8090.
WEBSERVER_PORT=
